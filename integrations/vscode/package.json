{
  "name": "d2mcp",
  "displayName": "D2 MCP Server",
  "description": "Create, edit, validate, render, and export D2 diagrams through MCP.",
  "version": "0.5.0",
  "publisher": "RecursiveFunctions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RecursiveFunctions/d2mcp.git"
  },
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "AI",
    "Visualization"
  ],
  "keywords": [
    "d2",
    "diagram",
    "mcp"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "d2mcp.docker",
        "label": "D2 MCP Server"
      }
    ],
    "commands": [
      {
        "command": "d2mcp.showConfiguration",
        "title": "Show MCP Configuration",
        "category": "D2 MCP"
      },
      {
        "command": "d2mcp.openDocumentation",
        "title": "Open Documentation",
        "category": "D2 MCP"
      }
    ]
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=dist/extension.js",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.js",
    "package": "npm run check && npm run test && npm run compile && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.102.0",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}